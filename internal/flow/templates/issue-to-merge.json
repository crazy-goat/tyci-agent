{
  "description": "Work on a GitHub issue: code, review, open a PR, wait for CI and merge.",
  "start": "check_done",
  "params": [{"name": "issue", "description": "GitHub issue number", "required": true}],
  "defaults": {"max_visits": 0},
  "states": {
    "check_done": {"check": "checks/issue_done.sh", "on": {"skip": "end", "go": "open_pr", "go-risky": "open_pr_risky", "default": "ask_check"}},
    "open_pr":    {"check": "checks/open_pr.sh", "on": {"none": "code", "found": "lock", "fail": "fixer", "default": "fixer"}},
    "open_pr_risky": {"check": "checks/open_pr.sh", "on": {"none": "plan", "found": "lock", "fail": "ask_plan", "default": "ask_plan"}},
    "plan":       {"agent": "oracle", "task": "plan", "on": {"done": "plan_review", "default": "ask_plan"}},
    "plan_review": {"agent": "oracle", "task": "plan_review", "on": {"APPROVE": "open_pr", "REJECT": "plan", "REJECT_LIMIT": "ask_plan", "DOUBT": "ask_plan", "default": "ask_plan"}},
    "ask_plan":   {"ask": "The plan of the risky issue waits for your decision. Answer approve to code the issue, replan to plan it again, or stop to end the run.", "human": true, "on": {"approve": "open_pr", "replan": "plan", "stop": "end"}},
    "code":       {"agent": "worker", "max_visits": 3, "on": {"done": "review", "default": "ask"}},
    "review":     {"agent": "review", "on": {"ACCEPT": "lock", "CHANGES": "code", "default": "ask"}},
    "lock":       {"check": "checks/lock.sh", "timeout_sec": 14400, "on": {"ok": "update", "timeout": "ask", "fail": "fixer", "default": "fixer"}},
    "update":     {"check": "checks/rebase.sh", "on": {"ok": "post_review", "conflict": "code", "fail": "fixer", "default": "fixer"}},
    "post_review": {"check": "checks/post_review.sh", "on": {"ok": "ci", "skip": "ci", "fail": "ci", "default": "ci"}},
    "ci":         {"check": "checks/ci_wait.sh", "max_visits": 3, "timeout_sec": 5400, "on": {"green": "comments", "red": "code", "conflict": "rebase", "behind": "rebase", "timeout": "ask", "fail": "fixer", "default": "fixer"}},
    "comments":   {"check": "checks/fetch_comments.sh", "on": {"none": "merge", "new": "code", "fail": "fixer", "default": "fixer"}},
    "merge": {"check": "checks/merge.sh", "guard": true, "on": {"merged": "findings", "behind": "rebase", "protected": "ask_protected", "fail": "fixer", "default": "fixer"}},
    "rebase":     {"check": "checks/rebase.sh", "on": {"ok": "ci", "conflict": "code", "fail": "fixer", "default": "fixer"}},
    "fixer":      {"agent": "fixer", "task": "fixer", "on": {"ok": "$failed", "failed": "oracle", "default": "oracle"}},
    "oracle":     {"agent": "oracle", "task": "recover", "on": {"stop": "end", "ask": "ask", "default": "ask"}},
    "findings":   {"agent": "review", "task": "findings_to_issues", "on": {"done": "end", "default": "end"}},
    "ask":        {"ask": "The run needs a human decision.", "on": {"retry": "code", "stop": "end"}},
    "end":        {"end": true},
    "ask_protected": {"ask": "The PR changes protected paths and waits for your approval. Answer approve to merge it, or stop to merge it by hand.", "human": true, "on": {"approve": "merge_approved", "stop": "end"}},
    "merge_approved": {"check": "checks/merge_approved.sh", "guard": true, "on": {"merged": "findings", "behind": "rebase", "protected": "ask_protected", "fail": "ask_protected", "default": "ask_protected"}},
    "ask_check": {"ask": "The issue gate issue_done.sh gave an unknown result. Check the issue and the script output of check_done. Answer retry to run the gate again, or stop to end the run.", "human": true, "on": {"retry": "check_done", "stop": "end"}}
  }
}

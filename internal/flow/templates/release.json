{
  "description": "Release a milestone: CHANGELOG PR, merge, annotated tag after a human yes, GitHub release, close the milestone.",
  "start": "preflight",
  "params": [{"name": "milestone", "description": "milestone title, for example v0.10.0", "required": true}],
  "defaults": {"max_visits": 0},
  "states": {
    "preflight":   {"check": "checks/release_preflight.sh", "on": {"ready": "ask_release", "fail": "failed", "default": "failed"}},
    "ask_release": {"ask": "The milestone is ready. Answer yes to tag and release it, or no to stop. A no changes nothing on GitHub.", "human": true, "on": {"yes": "code", "no": "declined", "default": "declined"}},
    "code":        {"agent": "worker", "task": "release_changelog", "max_visits": 3, "on": {"done": "push", "default": "ask"}},
    "push":        {"check": "checks/push.sh", "on": {"ok": "lock", "fail": "fixer", "default": "fixer"}},
    "lock":        {"check": "checks/lock.sh", "timeout_sec": 14400, "on": {"ok": "ci", "timeout": "ask", "fail": "fixer", "default": "fixer"}},
    "ci":          {"check": "checks/ci_wait.sh", "max_visits": 3, "timeout_sec": 5400, "on": {"green": "merge", "red": "code", "conflict": "rebase", "behind": "rebase", "timeout": "ask", "fail": "fixer", "default": "fixer"}},
    "merge": {"check": "checks/merge.sh", "guard": true, "on": {"merged": "tag", "behind": "rebase", "protected": "ask", "fail": "fixer", "default": "fixer"}},
    "rebase":      {"check": "checks/rebase.sh", "on": {"ok": "ci", "conflict": "code", "fail": "fixer", "default": "fixer"}},
    "tag": {"check": "checks/release_tag.sh", "guard": true, "on": {"tagged": "wait", "fail": "fixer", "default": "fixer"}},
    "wait":        {"check": "checks/release_wait.sh", "timeout_sec": 2100, "on": {"ok": "close", "failed": "failed", "default": "failed"}},
    "close":       {"check": "checks/milestone_close.sh", "on": {"ok": "done", "fail": "fixer", "default": "fixer"}},
    "fixer":       {"agent": "fixer", "task": "fixer", "on": {"ok": "$failed", "failed": "oracle", "default": "oracle"}},
    "oracle":      {"agent": "oracle", "task": "recover", "on": {"stop": "failed", "ask": "ask", "default": "ask"}},
    "ask":         {"ask": "The release run needs a human decision. If the CHANGELOG pull request is already merged, answer `goto tag`. If the release tag is already on origin, answer `goto wait`. Do not answer `retry` after the merge.", "on": {"retry": "code", "stop": "failed"}},
    "done":        {"end": true, "result": "done"},
    "declined":    {"end": true, "result": "declined"},
    "failed":      {"end": true, "result": "failed"}
  }
}

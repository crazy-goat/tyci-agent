{
  "name": "issue-to-merge",
  "start": "check_done",
  "defaults": {"max_visits": 0},
  "states": {
    "check_done": {"check": "checks/issue_done.sh", "on": {"skip": "end", "go": "code", "default": "ask"}},
    "code":       {"agent": "worker", "max_visits": 3, "on": {"done": "review", "default": "ask"}},
    "review":     {"agent": "review", "on": {"ACCEPT": "push", "CHANGES": "code", "default": "ask"}},
    "push":       {"check": "checks/push.sh", "on": {"ok": "ci", "fail": "ask", "default": "ask"}},
    "ci":         {"check": "checks/ci_wait.sh", "max_visits": 3, "timeout_sec": 5400, "on": {"green": "merge", "red": "code", "timeout": "ask", "fail": "ask", "default": "ask"}},
    "merge":      {"check": "checks/merge.sh", "on": {"merged": "findings", "behind": "rebase", "protected": "ask", "fail": "merge_decision", "default": "ask"}},
    "rebase":     {"check": "checks/rebase.sh", "on": {"ok": "ci", "conflict": "code", "fail": "merge_decision", "default": "ask"}},
    "merge_decision": {"agent": "merge_decision", "task": "merge_decision", "on": {"retry": "merge", "code": "code", "ask": "ask", "default": "ask"}},
    "findings":   {"agent": "review", "task": "findings_to_issues", "on": {"done": "end", "default": "end"}},
    "ask":        {"ask": "The run needs a human decision.", "on": {"retry": "code", "stop": "end"}},
    "end":        {"end": true}
  }
}

{
  "name": "issue-to-merge",
  "start": "check_done",
  "defaults": {"max_visits": 0},
  "states": {
    "check_done": {"check": "checks/issue_done.sh", "on": {"skip": "end", "go": "open_pr", "default": "fixer"}},
    "open_pr":    {"check": "checks/open_pr.sh", "on": {"none": "code", "found": "lock", "fail": "fixer", "default": "fixer"}},
    "code":       {"agent": "worker", "max_visits": 3, "on": {"done": "review", "default": "ask"}},
    "review":     {"agent": "review", "on": {"ACCEPT": "lock", "CHANGES": "code", "default": "ask"}},
    "lock":       {"check": "checks/lock.sh", "timeout_sec": 14400, "on": {"ok": "update", "timeout": "ask", "fail": "fixer", "default": "fixer"}},
    "update":     {"check": "checks/rebase.sh", "on": {"ok": "post_review", "conflict": "code", "fail": "fixer", "default": "fixer"}},
    "post_review": {"check": "checks/post_review.sh", "on": {"ok": "ci", "skip": "ci", "fail": "ci", "default": "ci"}},
    "ci":         {"check": "checks/ci_wait.sh", "max_visits": 3, "timeout_sec": 5400, "on": {"green": "comments", "red": "code", "conflict": "rebase", "behind": "rebase", "timeout": "ask", "fail": "fixer", "default": "fixer"}},
    "comments":   {"check": "checks/fetch_comments.sh", "on": {"none": "merge", "new": "code", "fail": "fixer", "default": "fixer"}},
    "merge":      {"check": "checks/merge.sh", "on": {"merged": "findings", "behind": "rebase", "protected": "ask", "fail": "fixer", "default": "fixer"}},
    "rebase":     {"check": "checks/rebase.sh", "on": {"ok": "ci", "conflict": "code", "fail": "fixer", "default": "fixer"}},
    "fixer":      {"agent": "fixer", "task": "fixer", "on": {"ok": "$failed", "failed": "oracle", "default": "oracle"}},
    "oracle":     {"agent": "oracle", "task": "recover", "on": {"stop": "end", "ask": "ask", "default": "ask"}},
    "findings":   {"agent": "review", "task": "findings_to_issues", "on": {"done": "end", "default": "end"}},
    "ask":        {"ask": "The run needs a human decision.", "on": {"retry": "code", "stop": "end"}},
    "end":        {"end": true}
  }
}
